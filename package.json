{
  "name": "misha-browser",
  "version": "0.1.0",
  "private": true,
  "description": "Browser extension and MCP server for browser and desktop control, with Misha's Slack and WhatsApp transports",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "default": "./dist/protocol/index.js"
    },
    "./protocol/framing": {
      "types": "./dist/protocol/framing.d.ts",
      "default": "./dist/protocol/framing.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./native-host": {
      "types": "./dist/host/launcher.d.ts",
      "default": "./dist/host/launcher.js"
    },
    "./modules": {
      "types": "./dist/modules.d.ts",
      "default": "./dist/modules.js"
    }
  },
  "bin": {
    "misha-browser-mcp": "./dist/mcp/server.js"
  },
  "scripts": {
    "build": "tsc && node scripts/build-extension.js",
    "store-archive": "tsc && node scripts/build-extension.js --store",
    "install-host": "node dist/host/install.js dist/extension",
    "disclosures": "tsc && node dist/disclosures/generate.js",
    "render-icons": "tsc && node scripts/render-icons.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "pnpm run build && node --test 'dist/**/*.spec.js'",
    "prepare": "pnpm run build"
  },
  "packageManager": "pnpm@11.11.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "robot-ts": "2.1.0",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@types/chrome": "0.3.7",
    "@types/node": "25.1.0",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.8",
    "oxfmt": "0.58.0",
    "oxlint": "1.73.0",
    "oxlint-tsgolint": "0.24.0",
    "typescript": "7.0.2"
  },
  "files": [
    "dist",
    "!dist/**/*.spec.*",
    "!dist/disclosures",
    "!dist/store",
    "!dist/store-archive"
  ]
}
