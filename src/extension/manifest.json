{
  "manifest_version": 3,
  "name": "Misha Browser",
  "description": "Misha's Slack transport: reads new messages in your signed-in Slack tab and makes allowlisted Slack calls there for the Misha app on this Mac, through a local native messaging host.",
  "version": "0.1.0",
  "key": "",
  "minimum_chrome_version": "140",
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["nativeMessaging", "scripting", "alarms", "unlimitedStorage"],
  "host_permissions": ["https://app.slack.com/*"],
  "content_scripts": [
    {
      "matches": ["https://app.slack.com/*"],
      "js": ["observer.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    { "matches": ["https://app.slack.com/*"], "js": ["relay.js"], "run_at": "document_start" }
  ]
}
