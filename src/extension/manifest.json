{
  "manifest_version": 3,
  "name": "Misha Browser",
  "description": "Connect local AI agents to your browser and signed-in Slack through the Misha app on your Mac.",
  "key": "",
  "minimum_chrome_version": "140",
  "icons": {
    "16": "icons/misha-16.png",
    "32": "icons/misha-32.png",
    "48": "icons/misha-48.png",
    "128": "icons/misha-128.png"
  },
  "action": { "default_title": "Misha Browser" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": [
    "nativeMessaging",
    "scripting",
    "alarms",
    "unlimitedStorage",
    "tabs",
    "webRequest",
    "downloads"
  ],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["https://app.slack.com/*"],
      "js": ["observer.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    { "matches": ["https://app.slack.com/*"], "js": ["relay.js"], "run_at": "document_start" }
  ]
}
