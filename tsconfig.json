{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024", "ESNext.TypedArrays", "DOM", "DOM.Iterable", "DOM.AsyncIterable"],
    "module": "nodenext",
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"],
    "declaration": true,

    "strict": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
